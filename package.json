{
  "name": "pixelwave",
  "version": "0.1.0",
  "private": true,
  "description": "A focused desktop video editor built with Electron.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "electron .",
    "build": "vite build",
    "test": "vitest",
    "check": "npm run test -- --run && npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@phosphor-icons/react": "^2.1.10",
    "ffmpeg-static": "5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^43.1.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  }
}
